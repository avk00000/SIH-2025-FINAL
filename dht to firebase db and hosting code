#include <WiFi.h>
#include <FirebaseESP32.h>
#include "DHT.h"

#define DHTPIN 4
#define DHTTYPE DHT11

DHT dht(DHTPIN, DHTTYPE);

// Firebase credentials (from your firebaseConfig)
#define DATABASE_URL "https://esp32-dht-project-52ad9-default-rtdb.firebaseio.com/"
#define DATABASE_SECRET "DVs4G6MkhhI5LOmTqUfivY5om1f9jkbyYZJpfTME"

// WiFi credentials
const char* ssid = "wifi";
const char* password = "12345678";

// Firebase objects
FirebaseData firebaseData;
FirebaseAuth auth;
FirebaseConfig config;

void setup() {
  Serial.begin(115200);
  dht.begin();

  // Connect to Wi-Fi
  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    Serial.print(".");
    delay(300);
  }

  Serial.println();
  Serial.println("WiFi Connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  // Configure Firebase
  config.database_url = DATABASE_URL;
  config.signer.tokens.legacy_token = DATABASE_SECRET;

  // Initialize Firebase
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  Serial.println("Firebase Initialized!");
}

void loop() {
  float h = dht.readHumidity();
  float t = dht.readTemperature();

  if (isnan(h) || isnan(t)) {
    Serial.println("Failed to read from DHT sensor!");
    delay(3000);
    return;
  }

  Serial.print("Temperature: ");
  Serial.print(t);
  Serial.print("°C  Humidity: ");
  Serial.print(h);
  Serial.println("%");

  // Upload temperature to Firebase
  if (Firebase.setFloat(firebaseData, "/sensor/temperature", t)) {
    Serial.println("✓ Temperature uploaded successfully");
    Serial.print("Path: ");
    Serial.println(firebaseData.dataPath());
  } else {
    Serial.println("✗ Temperature upload failed");
    Serial.println("Reason: " + firebaseData.errorReason());
  }

  // Upload humidity to Firebase
  if (Firebase.setFloat(firebaseData, "/sensor/humidity", h)) {
    Serial.println("✓ Humidity uploaded successfully");
    Serial.print("Path: ");
    Serial.println(firebaseData.dataPath());
  } else {
    Serial.println("✗ Humidity upload failed");
    Serial.println("Reason: " + firebaseData.errorReason());
  }

  Serial.println("---");
  delay(3000);
}
